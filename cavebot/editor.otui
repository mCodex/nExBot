CaveBotEditorButton < Button


CaveBotEditorPanel < MainWindow
  id: cavebotEditor
  text: Cave route editor
  width: 278
  visible: false
  @onEscape: self:hide()
  layout:
    type: verticalBox
    fit-children: true
  
  Label
    id: pos
    text-align: center
    text: -
    
  Panel
    id: buttons
    margin-top: 2
    layout:
      type: grid
      cell-size: 86 20
      cell-spacing: 1
      flow: true
      fit-children: true

  Label
    text: Select a route action, then choose an edit command.
    text-align: center
    text-auto-resize: true
    text-wrap: true
    margin-top: 3
    margin-left: 2
    margin-right: 2

  BotSwitch
    id: autoRecording
    text: Auto Recording
    margin-top: 3

  BotButton
    margin-top: 3
    margin-bottom: 3
    text: Documentation
    @onClick: g_platform.openUrl("https://www.nexbot.cc/docs")
