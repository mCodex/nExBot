NexButton < Button
  margin-top: 1
  margin-bottom: 1

NexIconButton < Button
  width: 20
  height: 20
  margin: 1

NexCard < Panel
  margin-left: 4
  margin-right: 4
  margin-top: 4
  margin-bottom: 4

NexSectionHeader < Panel
  margin-left: 6
  margin-top: 8
  margin-bottom: 2

NexBadge < Label
  margin-left: 2
  margin-right: 2

NexMetricCard < Panel
  margin: 4

NexRow < Panel
  margin-left: 6
  margin-right: 6
  margin-top: 2
  margin-bottom: 2

NexToolbar < Panel
  margin: 4

NexListRow < Panel
  margin-left: 6
  margin-right: 6
  margin-top: 2
  margin-bottom: 2

NexFooter < Panel
  margin: 4

NexShell < MainWindow
  text: nExBot
  @onEscape: self:hide()

-- Compact single-column shell that preserves the game viewport.
NexShellLayout < Panel
  layout:
    type: verticalBox

NexContent < Panel

NexEngineRow < Panel
  height: 26
  margin-left: 4
  margin-right: 4
  margin-top: 1
  margin-bottom: 1
  layout:
    type: horizontalBox

NexEngineItem < UIItem
  width: 24
  height: 24
  virtual: true
  draggable: false

NexCockpitFooter < Panel
  height: 30
  margin: 2
  layout:
    type: horizontalBox

NexFooter < Panel
  height: 32
